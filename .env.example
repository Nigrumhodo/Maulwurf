# Copiar a .env y completar con valores locales de prueba.
# NUNCA commitear .env. Los secretos reales van solo en el mecanismo de secretos del backend.
# En Docker Compose, MAULWURF_DATABASE_URL / MAULWURF_REDIS_URL usan los nombres de
# servicio (postgres, redis) en vez de localhost.

# --- Backend / API ---
MAULWURF_ENV=local
MAULWURF_SECRET_KEY=change-me-openssl-rand-hex-32
MAULWURF_ENCRYPTION_KEY=change-me-openssl-rand-hex-32   # AES-GCM, clave versionada (M1)
MAULWURF_ENCRYPTION_KEY_VERSION=1
MAULWURF_DATABASE_URL=postgresql+asyncpg://maulwurf:maulwurf@localhost:5432/maulwurf
MAULWURF_REDIS_URL=redis://localhost:6379/0
MAULWURF_OAUTH_STATE_SECRET=change-me
# Origin exacto que sirve Caddy; CSRF lo exige. Solo aplica a uvicorn standalone: con
# Docker Compose se deriva de CADDY_HTTPS_PORT (infra/docker-compose.yml) y este valor se ignora.
MAULWURF_PUBLIC_ORIGIN=https://localhost
# Si 80/443 están ocupados en tu máquina, descomenta y ajusta. Con Compose basta
# CADDY_HTTPS_PORT. Desde infra/ usa `docker compose --env-file ../.env ...`.
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
MAULWURF_SESSION_TTL_HOURS=168   # vida máxima de la sesión opaca; logout la revoca antes
# Contrato de ingesta S1 (A1.8); provisionales hasta D2/D4. Descomentar para cambiarlos.
# MAULWURF_PRIVACY_NOTICE_VERSION=2026-09-v1
# MAULWURF_INGEST_LANGUAGES=["es","en","fr"]
# MAULWURF_UPLOAD_MAX_BYTES=209715200
# MAULWURF_UPLOAD_TTL_MINUTES=15
# A2.4: expiración (minutos) del variant_confirmation_token del 409 duplicate_variant.
# Provisional: «expiración corta» de M2 sin número publicado; solo se persiste su hash.
# MAULWURF_VARIANT_TOKEN_TTL_MINUTES=5
# A2.2: JSON no sensible, publicado desde un spike aprobado. Mientras D4 siga bloqueada,
# omitirlo: GET /ingestion/capabilities devolverá null/listas vacías, no los valores S1.
# MAULWURF_INGESTION_CAPABILITIES='{"source_report":"docs/spike/F0.1-informe-riva.md","source_version":"2026-10-05","limits_validated":true,"max_upload_bytes":123456,"max_duration_seconds":60,"accepted_input_formats":["wav"],"languages":["es"],"ttl":{"upload_start_minutes":10,"receive_minutes":30,"asr_minutes":60},"asr":{"provider":"nvidia-riva","model":"whisper-large-v3","timestamp_precision":"none"},"active_slots":1,"required_stages":["index"]}'

# --- PostgreSQL local (Compose; solo desarrollo) ---
# La usan el contenedor postgres y el DSN de api/ingest en Compose.
POSTGRES_PASSWORD=maulwurf

# --- Google OAuth (credenciales de prueba, backend únicamente) ---
# Pasos en docs/RUNBOOK-dev.md §2 (Google login). La URI de redirección autorizada en
# Google Cloud debe ser exactamente https://localhost:<CADDY_HTTPS_PORT>/auth/google/callback.
MAULWURF_GOOGLE_CLIENT_ID=
MAULWURF_GOOGLE_CLIENT_SECRET=

# --- Embeddings versionados (L2.2, M6/D5) ---
# Proveedor compatible con la API de embeddings: el cliente hace POST a <base>/embeddings
# con {"input":[...], "model":...}. Sin base_url y api_key la indexación falla con
# `embedding_not_configured` (fail closed: no hay vectores falsos ni degradación silenciosa).
# MAULWURF_EMBEDDING_BASE_URL=https://api.openai.com/v1
# MAULWURF_EMBEDDING_API_KEY=
# MAULWURF_EMBEDDING_MODEL=text-embedding-3-small
# MAULWURF_EMBEDDING_DIMENSION=1536      # fijada por `embeddings.vector vector(1536)` (0002)
# MAULWURF_EMBEDDING_BATCH_SIZE=100      # textos por request; acotado (1..512)
# MAULWURF_EMBEDDING_MAX_RETRIES=3       # presupuesto de reintentos (429/5xx/red)
# MAULWURF_EMBEDDING_TIMEOUT_SECONDS=30
# D3-Texto (ESPECIFICACION §12): lista de modelos/proveedores con la decisión cerrada.
# VACÍA por defecto = fail closed: solo se indexa texto sintético o redactado (S2.md §0.6).
# Solo el lead la completa cuando registra el cierre de D3-Texto para ese modelo.
# MAULWURF_D3_TEXT_CLOSED_MODELS=[]

# --- NVIDIA Riva (solo backend, ver docs/NVIDIA_RIVA.md) ---
NVIDIA_API_KEY=
RIVA_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d   # function-id verificado en el spike F0.1 (informe §1)
RIVA_SERVER=grpc.nvcf.nvidia.com:443
RIVA_USE_SSL=true
RIVA_MAX_MESSAGE_LENGTH=1073741824

# --- Ingesta (límites provisorios; reemplazar por los medidos en el spike F0) ---
INGEST_MAX_UPLOAD_BYTES=209715200      # 200 MiB provisional, no aprobado hasta F0 (Santiago)
INGEST_FRAGMENT_OVERLAP_S=0.25         # solape local entre fragmentos; no es un límite de Riva
INGEST_FRAGMENT_SECONDS=30             # piso observado en el spike; no es un máximo aprobado
INGEST_SLOTS=2
INGEST_TMPFS_BYTES=268435456           # 256 MiB provisional por slot
# S1.B1: ingest no arranca si el proceso no está endurecido (root ro, tmpfs acotado, no root,
# sin core dumps ni swap). `report` solo para desarrollo fuera del contenedor: arranca, pero
# /readyz responde 503. Nunca en compose ni despliegue.
# INGEST_HARDENING=enforce
