# J1.3 / ADR-0008 / ADR-0010 — Caddy is the only public ingress.
# Same origin for the web SPA and the API. Ingest is not on this site: it
# listens on the `data` network only, and the API streams each upload to it
# (ADR-0008). `/internal/*` is answered here with 404 and never proxied.
#
# Uploads stream (no disk spool), nothing is cached, access logs do not record
# bodies, SSE flushes immediately, and the admin API is off.
#
# J2.10: the values below are the edge envelope. The contract limit stays the
# one published by GET /ingestion/capabilities and enforced by the API. Keep
# the upload ceiling above that limit so the API answers with its structured
# `payload_too_large` envelope instead of Caddy's plain 413.
{
	admin off

	# J2.10: no total write deadline (0) because `/audios/*/progress` is SSE and a
	# finite write timeout would cut long classes. read_body covers the provisional
	# 15-minute upload window with margin; read_header and idle stay bounded.
	servers {
		timeouts {
			read_body 20m
			read_header 30s
			write 0
			idle 5m
		}
	}
}

https://localhost {
	tls internal

	# 1) Binary PUT: ends at api; api streams to ingest over the internal network (ADR-0008).
	@upload {
		method PUT
		path /audios/*/content
	}
	handle @upload {
		# J2.10: 220 MB > the provisional 200 MiB API limit (209715200 bytes). The
		# margin lets the API return its 413 envelope; this ceiling only stops abusive
		# bodies before they reach the application. Re-check it if D4 publishes a
		# larger limit.
		request_body {
			max_size 220MB
		}
		reverse_proxy api:8000
	}

	# ADR-0008: ingest's internal API is never public. Caddy answers 404 before any other
	# route match; any variant that does not match falls through to the web fallback.
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	# 2) SSE de progreso: flush inmediato por evento.
	@progress path /audios/*/progress
	handle @progress {
		# J2.10: the matcher is path-only, so a POST to this URL would otherwise reach
		# the API with an unbounded body. The limit does not affect event streaming.
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# 2b) Chat SSE. More specific than @api so the stream is not buffered. Cancel and
	# the other chat routes stay on the JSON handler below.
	@chat_sse path /chat/conversations/*/messages
	handle @chat_sse {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# 3) API JSON, including the S2–S4 surfaces. A path missing here falls through to
	# the web SPA and the browser receives index.html instead of the API.
	# In Caddy 2.8 a single trailing `*` is a prefix match: `MatchPath` strips
	# the star and uses HasPrefix, so `/chat/*` already covers every deeper chat
	# route. Extra stars are a different matcher (`path.Match`, one segment
	# each) and are not used here. Bare collection routes (`/me`, `/tasks`)
	# stay exact because the prefix needs the slash after the root.
	@api path /auth/* /me /me/* /subjects /subjects/* /integrations/* /audios /audios/* /ingestion/* /search /chat/* /calendar /calendar/* /tasks /tasks/* /notifications /notifications/* /healthz /readyz
	handle @api {
		# J2.10: JSON bodies are small; this is an abuse guard, not a contract limit.
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000
	}

	# 4) Web (fallback). Every route that does not match above lands here, including
	# unknown PUT/POST paths. Without this ceiling the fallback would forward an
	# unbounded body; `read_body` bounds time, not size.
	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
