# J1.3 — Caddy TLS local, mismo origen para web/api/ingest.
# Reglas: streaming puro en uploads (sin buffers a disco), sin caché, sin
# captura de bodies en logs, flush inmediato en SSE y sin admin API publicada.
{
	admin off
}

https://localhost {
	tls internal

	# 1) Binary PUT: ends at api; api streams to ingest over the internal network (ADR-0008).
	@upload {
		method PUT
		path /audios/*/content
	}
	handle @upload {
		reverse_proxy api:8000
	}

	# ADR-0008: ingest's internal API is never public. Caddy answers 404 before any other
	# route match; any variant that does not match falls through to the web fallback.
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	# 2) SSE de progreso: flush inmediato por evento.
	@progress path /audios/*/progress
	handle @progress {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# 3) API JSON (M1/M2 y /readyz para el smoke I-S1-JF-01).
	@api path /auth/* /me /me/* /subjects /subjects/* /integrations/* /audios /audios/* /ingestion/* /readyz
	handle @api {
		reverse_proxy api:8000
	}

	# 4) Web (fallback).
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
