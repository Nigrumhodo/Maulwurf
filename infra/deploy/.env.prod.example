# Production environment template for infra/docker-compose.prod.yml.
# Copy to `.env.prod` on the target server (chmod 600 .env.prod) and fill in real values.
# NEVER commit `.env.prod`.

# --- Release & Domain ---
# Use `local` when building directly on the server (`docker compose ... build`), or a
# registry namespace (e.g. `ghcr.io/nigrumhodo`) when pulling prebuilt images.
MAULWURF_REGISTRY=local
# Immutable tag (e.g. short git SHA or semver); never `:latest`.
MAULWURF_IMAGE_TAG=v1.0.0
# Public HTTPS domain without scheme or trailing slash (Caddy issues Let's Encrypt TLS).
MAULWURF_DOMAIN=maulwurf.example.com

# --- Database & Redis (generate distinct strong passwords) ---
POSTGRES_USER=maulwurf
POSTGRES_DB=maulwurf
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24-postgres
# Redis reads this from the environment and writes a private config on tmpfs.
# It is not passed as `--requirepass` (that would show up in `ps` and `docker inspect`).
# Single-line hex only: whitespace is rejected at container start.
REDIS_PASSWORD=replace-with-openssl-rand-hex-24-redis

# Runtime DSNs. The migration owner (POSTGRES_USER / POSTGRES_PASSWORD) is used
# only by the `migrate` service. Apply infra/deploy/init-runtime-roles.sql after
# the first migration; the password in each URL must match the psql variable
# (DATABASE_PASSWORD_APP, DATABASE_PASSWORD_INGEST, DATABASE_PASSWORD_JOBS).
DATABASE_PASSWORD_APP=replace-with-openssl-rand-hex-24-app
DATABASE_PASSWORD_INGEST=replace-with-openssl-rand-hex-24-ingest
DATABASE_PASSWORD_JOBS=replace-with-openssl-rand-hex-24-jobs
DATABASE_URL_APP=postgresql+asyncpg://maulwurf_app_login:replace-with-openssl-rand-hex-24-app@postgres:5432/maulwurf
DATABASE_URL_INGEST=postgresql+asyncpg://maulwurf_ingest_login:replace-with-openssl-rand-hex-24-ingest@postgres:5432/maulwurf
DATABASE_URL_JOBS=postgresql+asyncpg://maulwurf_jobs_login:replace-with-openssl-rand-hex-24-jobs@postgres:5432/maulwurf

# --- Proxy trust ---
# Production runs behind Plane's front Caddy on the same host (docs/runbooks/deploy.md §1.1),
# so private_ranges preserves the client IP forwarded by Plane's Caddy for API rate limits.
# Narrow this to the shared Docker subnet once fixed (or 127.0.0.1/32 if Caddy is direct edge).
CADDY_TRUSTED_PROXIES=private_ranges
# Peers allowed to supply X-Forwarded-For to uvicorn. The default is the
# Compose `edge` subnet in docker-compose.prod.yml (172.28.10.0/24).
UVICORN_FORWARDED_ALLOW_IPS=172.28.10.0/24

# --- Boundary secrets (>= 32 bytes each, ALL distinct, never contain "change-me") ---
MAULWURF_SECRET_KEY=replace-with-openssl-rand-hex-32-session
MAULWURF_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-oauth
MAULWURF_OAUTH_STATE_SECRET=replace-with-openssl-rand-hex-32-state
MAULWURF_INGEST_CREDENTIAL_SECRET=replace-with-64-hex-chars-openssl-rand-hex-32
MAULWURF_METRICS_TOKEN=replace-with-openssl-rand-hex-32-metrics
# Distinct from MAULWURF_INGEST_CREDENTIAL_SECRET and from MAULWURF_METRICS_TOKEN.
# Write this value to infra/deploy/secrets/ingest_metrics_token (mode 0400).
# Write MAULWURF_METRICS_TOKEN to infra/deploy/secrets/api_metrics_token.
# Those files are gitignored. Do not reuse the ingest credential as a metrics bearer.
INGEST_METRICS_TOKEN=replace-with-openssl-rand-hex-32-ingest-metrics

# --- Google OAuth 2.0 ---
# Authorized redirect URI in Google Cloud Console:
# https://<MAULWURF_DOMAIN>/auth/google/callback
MAULWURF_GOOGLE_CLIENT_ID=
MAULWURF_GOOGLE_CLIENT_SECRET=

# --- Rate limits & M8 email reminders ---
MAULWURF_AUTH_RATE_LIMIT_PER_MINUTE=30
MAULWURF_INTEGRATION_RATE_LIMIT_PER_MINUTE=30
MAULWURF_NOTIFICATION_SCHEDULER_ENABLED=true
MAULWURF_NOTIFICATION_DELIVERY_ENABLED=true

# --- NVIDIA Riva ASR (ingest container only) ---
NVIDIA_API_KEY=
RIVA_SERVER=grpc.nvcf.nvidia.com:443
RIVA_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
RIVA_USE_SSL=true

# --- LLM (OpenAI-compatible endpoint for chat, summaries, and task extraction) ---
MAULWURF_LLM_BASE_URL=
MAULWURF_LLM_API_KEY=
MAULWURF_LLM_MODEL=
MAULWURF_LLM_MODEL_WINDOW=128000

# --- Embeddings (1536 dimensions pinned by pgvector schema) ---
MAULWURF_EMBEDDING_BASE_URL=
MAULWURF_EMBEDDING_API_KEY=
MAULWURF_EMBEDDING_MODEL=
MAULWURF_EMBEDDING_DIMENSION=1536
MAULWURF_EMBEDDING_ASYMMETRIC=true
MAULWURF_EMBEDDING_SEND_DIMENSIONS=true
MAULWURF_D3_TEXT_CLOSED_MODELS=[]

# --- Ingestion capabilities ---
# F0 gate: limits_validated stays false until the F0 capacity contract is approved.
# Setting it true skips that gate. Do not flip it in this template.
MAULWURF_INGESTION_CAPABILITIES='{"source_report":"docs/spike/F0.1-informe-riva.md","source_version":"2026-10-05","limits_validated":false,"max_upload_bytes":209715200,"max_duration_seconds":10800,"accepted_input_formats":["wav","mp3","m4a","ogg","webm","flac","opus"],"languages":["es","en"],"ttl":{"upload_start_minutes":10,"receive_minutes":30,"asr_minutes":60},"ttl_source_report":"docs/eval/ttl-benchmark.md","ttl_source_version":"2026-11-01","asr":{"provider":"nvidia-riva","model":"whisper-large-v3","timestamp_precision":"none"},"active_slots":1,"required_stages":["index","analyze"]}'
