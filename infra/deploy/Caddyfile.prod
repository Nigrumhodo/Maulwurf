# J4.7 — Production edge ingress over HTTPS (single origin for web + API).
{
	admin off

	servers {
		# Production runs behind the Plane stack's Caddy on the same host, which reaches this
		# Caddy from a private address. Trusting private peers keeps the real client IP for the
		# API rate limits; the front Caddy must not trust client-supplied X-Forwarded-For.
		# Narrow this to the shared network's subnet once it is fixed in the compose file.
		trusted_proxies static private_ranges
		timeouts {
			read_body 40m
			read_header 30s
			write 0
			idle 5m
		}
	}
}

{$MAULWURF_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Drop automated vulnerability/CMS scanner probes at the edge with 404.
	@scanner_probes {
		path /.env /.env.* /.git /.git/* /.aws/* /.htaccess /.htpasswd /docs /redoc /openapi.json /wp-login.php /wp-admin /wp-admin/* /wp-content/* /wp-includes/* /xmlrpc.php /phpmyadmin /phpmyadmin/* /pma /pma/* /admin.php /config.php /phpinfo.php *.php *.asp *.aspx *.jsp *.bak *.sql
	}
	handle @scanner_probes {
		respond 404
	}

	# Ephemeral streaming upload: API streams to ingest on the private data network.
	@upload {
		method PUT
		path /audios/*/content
	}
	handle @upload {
		request_body {
			max_size 220MB
		}
		reverse_proxy api:8000
	}

	# Internal metrics and ingest endpoints never leave the private data network.
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	@progress path /audios/*/progress
	handle @progress {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	@chat_sse path /chat/conversations/*/messages
	handle @chat_sse {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	@api path /auth/* /me /me/* /subjects /subjects/* /integrations/* /audios /audios/* /ingestion/* /search /chat/* /calendar /calendar/* /tasks /tasks/* /notifications /notifications/* /healthz /readyz
	handle @api {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000
	}

	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
