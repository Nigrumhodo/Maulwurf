shape: sequence_diagram

browser: Browser {shape: person}
api: api
google: "Google OAuth" {shape: cloud}
pg: PostgreSQL {shape: cylinder}

"1 · Start": {
  browser -> api: "GET /auth/google/start"
  api -> browser: "302 to Google + signed cookie mw_oauth_login\n(state, nonce, PKCE verifier)"
}

"2 · Consent": {
  browser -> google: "login and consent"
  google -> browser: "302 /auth/google/callback?code&state"
}

"3 · Callback": {
  browser -> api: "GET /auth/google/callback"
  api -> api: "verify signed cookie and state"
  api -> google: "exchange code + code_verifier"
  google -> api: "tokens + ID token"
  api -> api: "validate ID token (nonce, certs)"
  api -> pg: "upsert identity, store credential\nAES-GCM with key version"
  api -> browser: "302 / + Set-Cookie mw_session\nSecure, HttpOnly, SameSite=Lax\nonly its SHA-256 is stored"
}

"4 · Bootstrap": {
  browser -> api: "GET /me"
  api -> browser: "profile + csrf_token (HMAC of the session)"
}
