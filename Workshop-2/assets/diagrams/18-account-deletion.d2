req: "DELETE /me\nreturns 202" {class: neutral}
tomb: "1 · tombstone, ONE transaction\nblock the account, revoke other sessions,\nstop jobs and active attempts,\ncreate account_deletions (pending)" {class: svc}
claim: "2 · execute_account_deletion\nclaim pending → running\nbounded lease; a lost claim is a no-op" {class: svc}

remote: "3 · authorised Google deletions\nwhile the encrypted credential still exists" {
  class: zone
  k1: "delete_event" {class: svc}
  k2: "delete_calendar" {class: svc}
  k3: "account_cleanup" {class: svc}
  rs: "google_remote_operations\npending → running → succeeded | failed\nredacted error codes only" {class: store}
  k1 -> rs {class: flow}
  k2 -> rs {class: flow}
  k3 -> rs {class: flow}
}

purge: "4 · purge tenant data,\nprofile and tokens" {class: svc}
ok: "completed" {class: ok}
partial: "completed_with_remote_failures\nthe user can see why" {class: bad}
resume: "POST /me/deletion/{id}/resume\nafter a purge exception the claim is released;\nsucceeded remote operations are not resent" {class: note}
ret: "scheduler cron purge_residuals\nhourly, bounded batches\ndeletes expired account_deletions and\ngoogle_remote_operations rows" {class: svc}

req -> tomb {class: flow}
tomb -> claim {class: flow}
claim -> remote.k1 {class: flow}
claim -> remote.k2 {class: flow}
claim -> remote.k3 {class: flow}
remote.rs -> purge: "a failed remote operation\nnever cancels the purge" {class: flow}
purge -> ok {class: flow}
purge -> partial {class: flow}
purge -> resume: "exception" {class: flow}
resume -> claim {class: flow}
ok -> ret {class: flow}
partial -> ret {class: flow}
