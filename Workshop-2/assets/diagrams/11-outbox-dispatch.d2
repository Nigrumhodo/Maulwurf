title: |md
  # Figure 7.11 · Transactional outbox: from event to job
| {near: top-center}

direction: down

classes: {
  zone: {
    style: {
      fill: "#F7F8FA"
      stroke: "#B8C0CC"
      border-radius: 10
      font-size: 18
    }
  }
  svc: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 6
      font-size: 15
    }
  }
  ephemeral: {
    style: {
      fill: "#FFF3D6"
      stroke: "#B26A00"
      border-radius: 6
      font-size: 15
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  bus: {
    shape: queue
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  external: {
    shape: cloud
    style: {
      fill: "#EAF0FB"
      stroke: "#4766B8"
      font-size: 15
    }
  }
  flow: {
    style: {
      stroke: "#55606E"
      font-size: 13
    }
  }
  state: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 20
      font-size: 15
    }
  }
  ok: {
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      border-radius: 20
      font-size: 15
    }
  }
  bad: {
    style: {
      fill: "#FBEAEA"
      stroke: "#B24A4A"
      border-radius: 20
      font-size: 15
    }
  }
  neutral: {
    style: {
      fill: "#EEF0F3"
      stroke: "#55606E"
      border-radius: 20
      font-size: 15
    }
  }
  note: {
    style: {
      fill: "#FFFBEA"
      stroke: "#B8A04A"
      border-radius: 4
      font-size: 13
    }
  }
}


prod: "Producers (same transaction as the change)" {
  class: zone
  p1: "ingest commit\nindex_requested,\nanalyze_requested\ndisabled until cleanup verified" {class: ephemeral}
  p2: "api task confirm\nsync_task_event" {class: svc}
  p3: "other event types\ntask_cancelled, notify, send_digest,\ndelete_event, account_deleted\n(no consumer yet)" {class: neutral}
}

ob: "outbox_events\npending → dispatched → completed | failed | skipped" {class: store}

disp: "scheduler cron dispatch_outbox\nevery minute, batch of 100\nFOR UPDATE SKIP LOCKED" {class: svc}
pol: "services/outbox.py\npublication policy" {class: svc}

res: "Policy outcomes" {
  class: zone
  o1: "cleanup_pending\nstays gated" {class: neutral}
  o2: "disabled, no_consumer,\nunknown_type" {class: neutral}
  o3: "deduplicated\nalready in Redis" {class: neutral}
  o4: "publish" {class: ok}
}

rev: "outbox_revalidation\naudio still exists, owner\nstill active, version current" {class: svc}
enq: "outbox_delivery\nenqueue ID + version only\nbounded retry and backoff" {class: svc}
redis: "Redis queue arq:queue\nIDs only" {class: bus}
worker: "worker\nindex, analyze,\nsync_task_event" {class: svc}
rec: "scheduler cron reconcile\nevery 5 minutes\nlost dispatches back to pending" {class: svc}

prod.p1 -> ob {class: flow}
prod.p2 -> ob {class: flow}
prod.p3 -> ob {class: flow}
ob -> disp: "read batch" {class: flow}
disp -> pol {class: flow}
pol -> res.o1 {class: flow}
pol -> res.o2 {class: flow}
pol -> res.o3 {class: flow}
pol -> res.o4 {class: flow}
res.o4 -> rev {class: flow}
rev -> enq: "still publishable" {class: flow}
enq -> redis {class: flow}
redis -> worker: "job" {class: flow}
rec -> ob: "repair" {class: flow}
