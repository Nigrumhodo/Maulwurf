title: |md
  # Figure 7.1 · Maulwurf architecture by layers
| {near: top-center}

direction: right

classes: {
  zone: {
    style: {
      fill: "#F7F8FA"
      stroke: "#B8C0CC"
      border-radius: 10
      font-size: 18
    }
  }
  svc: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 6
      font-size: 15
    }
  }
  ephemeral: {
    style: {
      fill: "#FFF3D6"
      stroke: "#B26A00"
      border-radius: 6
      font-size: 15
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  bus: {
    shape: queue
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  external: {
    shape: cloud
    style: {
      fill: "#EAF0FB"
      stroke: "#4766B8"
      font-size: 15
    }
  }
  flow: {
    style: {
      stroke: "#55606E"
      font-size: 13
    }
  }
}

student: Student browser {
  shape: person
  style: {
    fill: "#EEF0F3"
    stroke: "#55606E"
  }
}

edge: Edge layer {
  class: zone
  caddy: "caddy 2.8\nTLS reverse proxy,\nno upload buffering" {class: svc}
  web: "web\nReact 19 SPA served\nby Express 5" {class: svc}
}

app: Application layer {
  class: zone
  api: "api · FastAPI\nOAuth, sessions, CSRF,\nREST, SSE, public PUT" {class: svc}
}

audio: Ephemeral audio zone {
  class: zone
  ingest: "ingest · FastAPI\nffmpeg, Riva client,\nprivate tmpfs" {class: ephemeral}
}

async: Async processing layer {
  class: zone
  scheduler: "scheduler · ARQ cron\noutbox dispatch,\nreconcile, retention" {class: svc}
  redis: "Redis 7.4\nARQ queues, IDs only,\nno persistence" {class: bus}
  worker: "worker · ARQ jobs\nindex, analyze,\nCalendar, Gmail" {class: svc}
}

data: Data layer {
  class: zone
  pg: "PostgreSQL 16 + pgvector\ntext, embeddings, tasks,\noutbox, forced RLS" {class: store}
}

ext: External services {
  class: zone
  riva: "NVIDIA Riva\nwhisper-large-v3" {class: external}
  llm: "LLM and\nembeddings" {class: external}
  google: "Google\nOAuth, Calendar,\nGmail" {class: external}
}

student -> edge.caddy: HTTPS {class: flow}
edge.caddy -> edge.web: "SPA, static" {class: flow}
edge.caddy -> app.api: "REST, SSE,\nPUT upload" {class: flow}

app.api -> audio.ingest: "chunked PUT,\nadmit / discard" {class: flow}
audio.ingest -> ext.riva: "gRPC TLS,\nfragments" {class: flow}
audio.ingest -> data.pg: "transcript,\ncleanup evidence" {class: flow}

app.api -> data.pg: "tenant data,\noutbox rows" {class: flow}
app.api -> ext.llm: "query embedding,\nchat stream" {class: flow}
app.api -> ext.google: "OAuth, reads" {class: flow}

async.scheduler -> data.pg: "reads outbox" {class: flow}
async.scheduler -> async.redis: "enqueues IDs" {class: flow}
async.redis -> async.worker: jobs {class: flow}
async.worker -> data.pg: "index, tasks" {class: flow}
async.worker -> ext.llm: "embeddings,\nextraction" {class: flow}
async.worker -> ext.google: "confirmed events,\nopt-in mail" {class: flow}
