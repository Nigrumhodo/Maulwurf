title: |md
  # Figure 7.16 · Calendar sync: confirmed task to Google event
| {near: top-center}

direction: down

classes: {
  zone: {
    style: {
      fill: "#F7F8FA"
      stroke: "#B8C0CC"
      border-radius: 10
      font-size: 18
    }
  }
  svc: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 6
      font-size: 15
    }
  }
  ephemeral: {
    style: {
      fill: "#FFF3D6"
      stroke: "#B26A00"
      border-radius: 6
      font-size: 15
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  bus: {
    shape: queue
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  external: {
    shape: cloud
    style: {
      fill: "#EAF0FB"
      stroke: "#4766B8"
      font-size: 15
    }
  }
  flow: {
    style: {
      stroke: "#55606E"
      font-size: 13
    }
  }
  state: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 20
      font-size: 15
    }
  }
  ok: {
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      border-radius: 20
      font-size: 15
    }
  }
  bad: {
    style: {
      fill: "#FBEAEA"
      stroke: "#B24A4A"
      border-radius: 20
      font-size: 15
    }
  }
  neutral: {
    style: {
      fill: "#EEF0F3"
      stroke: "#55606E"
      border-radius: 20
      font-size: 15
    }
  }
  note: {
    style: {
      fill: "#FFFBEA"
      stroke: "#B8A04A"
      border-radius: 4
      font-size: 13
    }
  }
}


st: "calendar_sync_status" {
  class: zone
  nr: "not_requested" {class: neutral}
  pe: "pending" {class: state}
  sy: "synced" {class: ok}
  fa: "failed" {class: bad}
  bl: "blocked" {class: bad}
  nr -> pe: "confirm, integration ready" {class: flow}
  nr -> bl: "confirm, no ready integration" {class: flow}
  pe -> sy: "event written" {class: flow}
  pe -> fa: "budget spent or permanent error" {class: flow}
  pe -> bl: "invalid_grant" {class: flow}
  bl -> pe: "reconnect resumes the same version" {class: flow}
  fa -> pe: "explicit retry" {class: flow}
}

confirm: "POST /tasks/{id}/confirm\none transaction: task version +\nsync_task_event outbox row" {class: svc}
disp: "outbox dispatcher\nIDs and version only" {class: svc}
job: "worker job sync_task_event\nresolve task under the jobs policy,\nbind owner; stale version cannot write" {class: svc}
tok: "google_tokens\nrefresh access token from the encrypted\nrefresh token, under a row lock" {class: svc}
gw: "google_calendar.py\ndedicated «Maulwurf» calendar\nIf-Match ETag, bounded retries,\nRetry-After, no transport retry on POST" {class: svc}
gcal: "Google Calendar API" {class: external}
conflict: "412 stale ETag\nexternal conflict for review,\nnever an overwrite" {class: note}
retry: "transient errors → Retry\n4 tries, task stays pending" {class: note}

confirm -> disp {class: flow}
disp -> job {class: flow}
job -> tok {class: flow}
tok -> gw {class: flow}
gw -> gcal: "HTTPS" {class: flow}
gcal -> conflict: "412" {class: flow}
job -> retry {class: flow}
job -> st.pe: "settles status" {class: flow}
