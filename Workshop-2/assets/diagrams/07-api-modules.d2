title: |md
  # Figure 7.7 · API: routers, services and persistence (apps/api/app)
| {near: top-center}

direction: right

classes: {
  zone: {
    style: {
      fill: "#F7F8FA"
      stroke: "#B8C0CC"
      border-radius: 10
      font-size: 18
    }
  }
  svc: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 6
      font-size: 15
    }
  }
  ephemeral: {
    style: {
      fill: "#FFF3D6"
      stroke: "#B26A00"
      border-radius: 6
      font-size: 15
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  bus: {
    shape: queue
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      font-size: 15
    }
  }
  external: {
    shape: cloud
    style: {
      fill: "#EAF0FB"
      stroke: "#4766B8"
      font-size: 15
    }
  }
  flow: {
    style: {
      stroke: "#55606E"
      font-size: 13
    }
  }
  state: {
    style: {
      fill: "#FFFFFF"
      stroke: "#3B5B8C"
      border-radius: 20
      font-size: 15
    }
  }
  ok: {
    style: {
      fill: "#E6F2EA"
      stroke: "#2E7D5B"
      border-radius: 20
      font-size: 15
    }
  }
  bad: {
    style: {
      fill: "#FBEAEA"
      stroke: "#B24A4A"
      border-radius: 20
      font-size: 15
    }
  }
  neutral: {
    style: {
      fill: "#EEF0F3"
      stroke: "#55606E"
      border-radius: 20
      font-size: 15
    }
  }
  note: {
    style: {
      fill: "#FFFBEA"
      stroke: "#B8A04A"
      border-radius: 4
      font-size: 13
    }
  }
}


routers: "routers/" {
  class: zone
  r1: "auth, me, subjects" {class: svc}
  r2: "audios, ingestion" {class: svc}
  r3: "search, chat" {class: svc}
  r4: "tasks, calendar,\nintegrations" {class: svc}
  r5: "notifications,\nhealth, internal_metrics" {class: svc}
}

services: "services/" {
  class: zone
  s1: "sessions, oauth_google,\ngoogle_tokens, tenant,\ndeletion" {class: svc}
  s2: "audios, uploads, dedupe,\nstate_machine, progress,\ningest_sink, ingest_credential" {class: svc}
  s3: "retrieval, search, rag,\nchat_stream, chat_tools,\ncitations, llm, embeddings" {class: svc}
  s4: "analysis*, tasks, task_*,\nrevisions, date_resolution,\nconflicts" {class: svc}
  s5: "google_calendar, calendar_*" {class: svc}
  s6: "notifications, reminders,\ndigests, gmail, scheduler_lease" {class: svc}
  s7: "outbox, outbox_retry,\nreconciliation, runs,\nindex_job, indexing, chunking" {class: svc}
}

core: "core/\nconfig, db, deps, crypto, security,\nerrors, logging, redis, providers" {class: neutral}
pg: "PostgreSQL\nmodels/ + 25 Alembic migrations" {class: store}
redis: "Redis\nrate limits, quotas" {class: bus}
ext: "LLM, embeddings,\nGoogle, ingest" {class: external}

routers.r1 -> services.s1 {class: flow}
routers.r2 -> services.s2 {class: flow}
routers.r3 -> services.s3 {class: flow}
routers.r4 -> services.s4 {class: flow}
routers.r4 -> services.s5 {class: flow}
routers.r5 -> services.s6 {class: flow}
services.s2 -> services.s7: "outbox rows" {class: flow}
services.s4 -> services.s7: "sync_task_event" {class: flow}
services.s1 -> core {class: flow}
services.s7 -> pg {class: flow}
services.s3 -> pg {class: flow}
services.s4 -> pg {class: flow}
services.s3 -> redis {class: flow}
services.s3 -> ext {class: flow}
services.s5 -> ext {class: flow}
services.s2 -> ext {class: flow}
